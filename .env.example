# =============================================================
# AgriIntel — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode — set to "true" to use local demo data instead of live APIs.
# Keep true for hackathon demo to avoid API failures during presentation.
NEXT_PUBLIC_DEMO_MODE=true

# =============================================================
# Database (Supabase)
# Get these from: https://app.supabase.com → Settings → API
# =============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER SIDE ONLY — never expose in browser

# =============================================================
# Market Data — AGMARKNET / data.gov.in
# Free registration at: https://data.gov.in/user/register
# =============================================================
AGMARKNET_API_KEY=
AGMARKNET_BASE_URL=https://api.data.gov.in/resource/

# =============================================================
# Weather — Open-Meteo (no API key required, leave blank)
# =============================================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/

# =============================================================
# Satellite — Sentinel Hub
# Register at: https://www.sentinel-hub.com/
# =============================================================
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# =============================================================
# AI Assistant — Google Gemini
# Get key at: https://aistudio.google.com/app/apikey
# =============================================================
GEMINI_API_KEY=

# =============================================================
# Voice (optional) — Google Cloud
# Web Speech API is used as free in-browser fallback.
# Only set these if you want higher-quality cloud voice.
# =============================================================
GOOGLE_CLOUD_STT_KEY=
GOOGLE_CLOUD_TTS_KEY=

# =============================================================
# ML Service — FastAPI Python sidecar
# =============================================================
ML_SERVICE_URL=http://localhost:8000

# =============================================================
# Demo Scenario Config
# =============================================================
DEMO_FARM_ID=demo-soybean-maharashtra
